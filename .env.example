# Copy this file to .env and fill in real values. Never commit .env.

# Aiven MySQL connection string (ask the DB owner; don't post it in chat)
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb
# Set to false only for a local MySQL without SSL
DB_SSL=true

# Long random string, at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe (test mode only; the server refuses live keys). Get keys at dashboard.stripe.com with "Test mode" on.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Test charges are refunded right after checkout unless this is "false"
STRIPE_AUTO_REFUND=true
# Optional: public URL Stripe sends shoppers back to (defaults to the request's own origin)
# SITE_URL=https://bookworms.example.com
