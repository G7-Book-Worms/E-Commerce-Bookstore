# Copy this file to .env and fill in real values. Never commit .env or paste it into chat.
# The same names are set in Vercel (Project → Settings → Environment Variables).

# --- Database (Aiven MySQL) ---
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb
# Set to false only for a local MySQL without TLS
DB_SSL=true
# Optional: Aiven's CA certificate (Aiven console → service → Overview → "CA certificate").
# Paste the PEM with \n for line breaks. When set, the database certificate is verified.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# --- Sign-in tokens ---
# Long random string, at least 32 characters (`openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# --- Stripe (test mode only; the server refuses live keys) ---
STRIPE_SECRET_KEY=sk_test_replace_me
# Refund every test payment right after checkout (keep true)
STRIPE_AUTO_REFUND=true

# --- Site ---
# Public URL used in emails and Stripe return links
SITE_URL=http://localhost:3000

# --- Email (Namecheap Private Email). Leave out locally: emails are printed to the console ---
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# Sends sign-up, order and password emails
# NOREPLY_EMAIL=no-reply@bookwrms.store
# NOREPLY_EMAIL_PASSWORD=
# Reply-to address; staff replies to contact messages are sent from here; low-stock alerts go here
# SUPPORT_EMAIL=support@bookwrms.store
# SUPPORT_EMAIL_PASSWORD=
